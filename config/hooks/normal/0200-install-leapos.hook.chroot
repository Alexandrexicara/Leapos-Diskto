#!/bin/sh
set -eu
# Os aplicativos sao instalados pelo mecanismo includes.chroot.
test -f /usr/local/lib/python3/dist-packages/leapos/desktop.py
test -f /usr/local/lib/python3/dist-packages/leapos/apps.py
test -f /usr/share/leapos/config/apps.json
python3 -m compileall -q /usr/local/lib/python3/dist-packages/leapos
